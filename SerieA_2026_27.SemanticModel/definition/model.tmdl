model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolderPath","FnWikipediaImage","DimClub","DimPlayer","FactStandings","FactPlayerStat"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table DimClub
ref table DimPlayer
ref table FactStandings
ref table FactPlayerStat

ref role Viewer

ref cultureInfo en-US

